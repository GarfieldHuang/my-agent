# ── OpenAI OAuth ──────────────────────────────────
# 在 https://platform.openai.com/settings/organization/apps 建立 OAuth app
OPENAI_CLIENT_ID=your_client_id
OPENAI_CLIENT_SECRET=your_client_secret

# 或直接用 API key（跳過 OAuth）
# OPENAI_API_KEY=sk-...

# ── Agent 設定 ────────────────────────────────────
OPENAI_MODEL=gpt-4o
OAUTH_REDIRECT_URI=http://localhost:8899/callback
