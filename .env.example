# ── OpenAI OAuth App ──────────────────────────────────────────────
# 申請網址：https://platform.openai.com/settings/organization/apps
# 建立 OAuth App 後：
#   - Redirect URI 填：http://localhost:1455/auth/callback
#   - 複製 Client ID 貼到下方
#
# 每個安裝這個 agent 的人共用同一個 Client ID，
# 但各自用自己的 ChatGPT 帳號（Plus/Pro）登入。

OPENAI_CLIENT_ID=your_client_id_here

# ── 其他設定 ──────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o
