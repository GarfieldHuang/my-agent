# ── OpenAI OAuth App ──────────────────────────────────────────────
# 預設已內建 client_id，不需要填也能直接用。
# 若要換成自己申請的 App，才需要設定這個：
# 申請網址：https://platform.openai.com/settings/organization/apps
# Redirect URI 填：http://localhost:1455/auth/callback

# OPENAI_CLIENT_ID=your_client_id_here

# ── 其他設定 ──────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o

# 每則訊息最多跑幾輪工具呼叫（預設 10；複雜任務如瀏覽器操作可調高）
# MAX_TOOL_ROUNDS=25

# ── 登入流程（出現 token_exchange_failed 時才需要動）─────────────
# codex_cli_simplified_flow 會讓 OpenAI 在伺服器端多做一次 token 交換。
# 那一步失敗時瀏覽器會停在他們自己的錯誤頁，不會導回本機，程式偵測不到。
# 設 0 改走標準 OAuth code flow，由本程式自己拿 code 換 token。
# OPENAI_CODEX_SIMPLIFIED_FLOW=0
#
# 不要求把組織資訊寫進 ID token。公司 Business / Enterprise workspace
# 若對此有限制，這一步就是 token_exchange_failed 的來源。
# OPENAI_ADD_ORGANIZATIONS=0
#
# OpenAI 用來識別呼叫端的字串，可能因對方調整白名單而不被接受。
# OPENAI_ORIGINATOR=codex_cli_rs

# Log 詳細程度（預設 INFO）。追查問題時才開 DEBUG。
# httpx / httpcore / openai 等第三方套件無論如何都壓在 WARNING——
# 它們在 DEBUG 會把含 OAuth token 與 cookie 的完整 HTTP 標頭寫進 agent.log。
# MY_AGENT_LOG_LEVEL=DEBUG

# ── 生圖（gpt-image-2）────────────────────────────────────────────
# 生圖是掛在文字模型上的 hosted tool，預設用 OPENAI_MODEL 當載具。
# 若生圖失敗可試著指定其他載具模型：
# OPENAI_IMAGE_WRAPPER_MODEL=gpt-5.6
